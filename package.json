{
  "name": "chronolog-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "check:commit": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run packages/canonical/src/cbor.fuzz.test.ts packages/protocol/src/sql.fuzz.test.ts",
    "test:publication-crash": "vitest run test/materializer-publication-crash.integration.test.ts",
    "test:native-sanitizers": "bash tools/run-native-sanitizers.sh",
    "bench:ingest": "tsx tools/bench-ingest.ts",
    "bench:materialize": "tsx tools/bench-materialize.ts",
    "test:soak": "tsx packages/conformance/src/release-characterization.ts --iterations 500 --reopen-every 25 --late-every 10 --late-depth 7 --output artifacts/release/soak.json",
    "characterize": "tsx packages/conformance/src/release-characterization.ts --iterations 100 --reopen-every 20 --late-every 10 --late-depth 5 --output artifacts/release/characterization.json",
    "release:metadata": "pnpm build && tsx tools/generate-release-metadata.ts --output artifacts/release",
    "release:distribution": "tsx tools/build-distribution.ts --output artifacts/distribution",
    "test:distribution-package": "tsx tools/test-distribution-package.ts --directory artifacts/distribution",
    "test:distribution-upgrade": "tsx tools/test-distribution-upgrade.ts --directory artifacts/distribution",
    "drill": "tsx tools/drill.ts",
    "conformance": "tsx packages/conformance/src/conformance-report.ts --output artifacts/conformance/report.json",
    "conformance:production": "tsx packages/conformance/src/conformance-report.ts --require-feature deployment-native-daemon-v1 --output artifacts/conformance/production-native.json",
    "conformance:compare": "tsx packages/conformance/src/compare-reports.ts",
    "dev": "tsx apps/chronologd/src/main.ts",
    "cli": "tsx apps/chronolog/src/main.ts",
    "snapshot": "tsx apps/chronologd/src/snapshot.ts",
    "group": "tsx apps/chronologd/src/group.ts",
    "demo": "tsx examples/end-to-end.ts",
    "demo:ownership": "tsx examples/shared-notes.ts",
    "chaos": "tsx packages/chaos/src/cli.ts",
    "chaos:smoke": "tsx packages/chaos/src/cli.ts run smoke",
    "chaos:crash": "tsx packages/chaos/src/cli.ts run crash",
    "chaos:stress": "tsx packages/chaos/src/cli.ts run stress",
    "docs:check": "node tools/check-doc-links.mjs",
    "prepare": "husky",
    "package:membership": "node tools/package-membership.mjs",
    "package:signals": "node tools/package-signals.mjs",
    "test:signals-package": "node tools/test-signals-package.mjs"
  },
  "devDependencies": {
    "@chronolog/agent-service": "workspace:*",
    "@chronolog/capabilities": "workspace:*",
    "@chronolog/client": "workspace:*",
    "@chronolog/control-store": "workspace:*",
    "@chronolog/crypto": "workspace:*",
    "@chronolog/materializer": "workspace:*",
    "@chronolog/materializer-doltlite": "workspace:*",
    "@chronolog/node-core": "workspace:*",
    "@chronolog/protocol": "workspace:*",
    "@chronolog/records": "workspace:*",
    "@chronolog/rpc": "workspace:*",
    "@chronolog/runtime-browser": "workspace:*",
    "@chronolog/runtime-workerd": "workspace:*",
    "@chronolog/signals": "workspace:*",
    "@chronolog/transport-ssb": "workspace:*",
    "@chronolog/transport-tendriller": "workspace:*",
    "@chronolog/transport-webrtc": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@tendriller/core": "file:./test/artifacts/tendriller-sdk-0b690952.tgz",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "miniflare": "5.20261110.2-beta",
    "node-gyp": "11.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4",
    "ws": "8.21.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "blake3"
    ],
    "onlyBuiltDependencies": [
      "@dolthub/doltlite",
      "esbuild",
      "leveldown",
      "sodium-native"
    ],
    "patchedDependencies": {
      "@dolthub/doltlite@0.11.29": "patches/@dolthub__doltlite@0.11.29.patch"
    }
  }
}
