{
  "name": "chronolog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:sqlite-cas": "node tools/build-sqlite-cas.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "check:commit": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run packages/canonical/src/cbor.fuzz.test.ts",
    "docs:check": "node tools/check-doc-links.mjs",
    "prepare": "husky",
    "package:signals": "node tools/package-signals.mjs",
    "test:signals-package": "node tools/test-signals-package.mjs",
    "package:session": "node tools/package-peer-session.mjs",
    "test:session-webrtc": "tsx tools/test-peer-session-webrtc.ts",
    "package:authority": "node tools/package-authority.mjs",
    "bench": "tsx bench/sync.bench.ts"
  },
  "devDependencies": {
    "@chronolog/authority": "workspace:*",
    "@chronolog/crypto": "workspace:*",
    "@chronolog/materializer": "workspace:*",
    "@chronolog/peer-session": "workspace:*",
    "@chronolog/protocol": "workspace:*",
    "@chronolog/records": "workspace:*",
    "@chronolog/signals": "workspace:*",
    "chronolog-db": "workspace:*",
    "@chronolog/transport-webrtc": "workspace:*",
    "@chronolog/transport-websocket": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.28.2",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
