+  bool hasActor = info.Length() >= 3 && !info[2].IsNull() && !info[2].IsUndefined();
+  bool hasActorId = info.Length() >= 4 && !info[3].IsNull() && !info[3].IsUndefined();
+  if (info.Length() < 2 || !info[0].IsBigInt() || !info[1].IsNumber() ||
+      (hasActor && !info[2].IsTypedArray()) || (hasActorId && !info[3].IsBigInt())) {
+    Napi::TypeError::New(env, "setDeterministicContext(unixMs: bigint, seed: number, actor?: Uint8Array | null, actorId?: bigint | null)").ThrowAsJavaScriptException();
+    return env.Undefined();
