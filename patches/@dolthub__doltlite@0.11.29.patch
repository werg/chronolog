+    if (array.TypedArrayType() != napi_uint8_array || array.ByteLength() < 1 || array.ByteLength() > 64) {
+      Napi::RangeError::New(env, "Deterministic actor must be 1 to 64 bytes").ThrowAsJavaScriptException();
+      return env.Undefined();
+    }
+    actor.assign((const char*)array.Data(), array.ByteLength());
+  }
+  bool lossless = false;
+  int64_t unixMs = info[0].As<Napi::BigInt>().Int64Value(&lossless);
+  if (!lossless || unixMs < 0 || unixMs > 253402300799999LL) {
+    Napi::RangeError::New(env, "Deterministic time is out of range").ThrowAsJavaScriptException();
+    return env.Undefined();
+  }
+  int64_t actorId = 0;
+  if (hasActorId) {
+    bool actorIdLossless = false;
+    actorId = info[3].As<Napi::BigInt>().Int64Value(&actorIdLossless);
+    if (!actorIdLossless || actorId < 1) {
+      Napi::RangeError::New(env, "Deterministic actor id must be a positive 64-bit integer").ThrowAsJavaScriptException();
+      return env.Undefined();
