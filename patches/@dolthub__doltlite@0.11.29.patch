@@ -1,14 +1,208 @@
 #include "database.h"
 #include "statement.h"
 
+#include <cstring>
+#include <ctime>
+#include <string>
+
+// ── Deterministic engine inputs ─────────────────────────────────────────────
+// A wrapper of the default VFS whose clock can be pinned to a transaction's
+// signed timestamp. All other methods are the default VFS's own.
+static sqlite3_vfs g_chronologVfs;
+static sqlite3_vfs* g_baseVfs = nullptr;
+static bool g_fixedTime = false;
+static sqlite3_int64 g_fixedJulianMs = 0;
+
+static int ChronologCurrentTimeInt64(sqlite3_vfs*, sqlite3_int64* out) {
+  if (g_fixedTime) { *out = g_fixedJulianMs; return SQLITE_OK; }
+  if (g_baseVfs->iVersion >= 2 && g_baseVfs->xCurrentTimeInt64) return g_baseVfs->xCurrentTimeInt64(g_baseVfs, out);
+  double now = 0;
+  int rc = g_baseVfs->xCurrentTime(g_baseVfs, &now);
+  *out = (sqlite3_int64)(now * 86400000.0);
+  return rc;
+}
+
+static int ChronologCurrentTime(sqlite3_vfs* vfs, double* out) {
+  sqlite3_int64 ms = 0;
+  int rc = ChronologCurrentTimeInt64(vfs, &ms);
+  *out = ms / 86400000.0;
+  return rc;
+}
+
+static int ChronologUtcLocaltime(const void* t, void* tm) {
+#ifdef _WIN32
+  return gmtime_s((struct tm*)tm, (const time_t*)t) == 0 ? 0 : 1;
+#else
+  return gmtime_r((const time_t*)t, (struct tm*)tm) ? 0 : 1;
+#endif
+}
+
+// The signing key of the transaction being executed; chronolog_actor()
+// returns it, and NULL outside consensus execution.
+static bool g_hasActor = false;
+static std::string g_actor;
+// The signer's principal id in the database; chronolog_actor_id() returns it.
+static bool g_hasActorId = false;
+static sqlite3_int64 g_actorId = 0;
+
+extern "C" void chronologSetDeterministicContext(sqlite3_int64 unixMs, unsigned int seed,
+                                                 const unsigned char* actor, size_t actorBytes,
+                                                 int hasActorId, sqlite3_int64 actorId) {
+  g_hasActorId = hasActorId != 0;
+  g_actorId = actorId;
+  g_hasActor = actor != nullptr;
+  g_actor.assign(actor == nullptr ? "" : std::string((const char*)actor, actorBytes));
+  g_fixedJulianMs = unixMs + 210866760000000LL;
+  g_fixedTime = true;
+  sqlite3_test_control(SQLITE_TESTCTRL_PRNG_SEED, (int)(seed == 0 ? 1u : seed), (sqlite3*)nullptr);
+  sqlite3_test_control(SQLITE_TESTCTRL_LOCALTIME_FAULT, 2, ChronologUtcLocaltime);
+}
+
+extern "C" void chronologClearDeterministicContext(void) {
+  g_hasActor = false;
+  g_actor.clear();
+  g_hasActorId = false;
+  g_actorId = 0;
+  g_fixedTime = false;
+  sqlite3_test_control(SQLITE_TESTCTRL_PRNG_SEED, 0, (sqlite3*)nullptr);
+  sqlite3_test_control(SQLITE_TESTCTRL_LOCALTIME_FAULT, 0);
+}
+
+// chronolog_assert(condition, code): 1 when condition is true, otherwise a
+// SQLITE_CONSTRAINT_FUNCTION error whose message is "chronolog_assert:<code>".
+static void ChronologAssert(sqlite3_context* ctx, int, sqlite3_value** argv) {
+  int codeBytes = sqlite3_value_bytes(argv[1]);
+  const unsigned char* code = sqlite3_value_text(argv[1]);
+  if (sqlite3_value_type(argv[1]) != SQLITE_TEXT || code == nullptr || codeBytes < 1 || codeBytes > 128) {
+    sqlite3_result_error(ctx, "chronolog_assert: code must be text of 1 to 128 bytes", -1);
+    return;
+  }
+  bool truthy = false;
+  switch (sqlite3_value_numeric_type(argv[0])) {
+    case SQLITE_NULL: truthy = false; break;
+    case SQLITE_INTEGER: truthy = sqlite3_value_int64(argv[0]) != 0; break;
+    default: truthy = sqlite3_value_double(argv[0]) != 0.0; break;
+  }
+  if (truthy) { sqlite3_result_int(ctx, 1); return; }
+  std::string message = "chronolog_assert:" + std::string((const char*)code, (size_t)codeBytes);
+  sqlite3_result_error(ctx, message.c_str(), (int)message.size());
+  sqlite3_result_error_code(ctx, SQLITE_CONSTRAINT_FUNCTION);
+}
+
+// chronolog_actor(): the signing key of the transaction being executed, or
+// NULL outside consensus execution. Not deterministic: it depends on context.
+static void ChronologActor(sqlite3_context* ctx, int, sqlite3_value**) {
+  if (!g_hasActor) { sqlite3_result_null(ctx); return; }
+  sqlite3_result_blob(ctx, g_actor.data(), (int)g_actor.size(), SQLITE_TRANSIENT);
+}
+
+// chronolog_actor_id(): the signer's principal id (chronolog_principals.id),
+// or NULL outside consensus execution. The owner column's default.
+static void ChronologActorId(sqlite3_context* ctx, int, sqlite3_value**) {
+  if (!g_hasActorId) { sqlite3_result_null(ctx); return; }
+  sqlite3_result_int64(ctx, g_actorId);
+}
+
+static bool PolicyPart(sqlite3_value* value, std::string* out) {
+  int bytes = sqlite3_value_bytes(value);
+  const unsigned char* text = sqlite3_value_text(value);
+  if (sqlite3_value_type(value) != SQLITE_TEXT || text == nullptr || bytes < 1 || bytes > 128) return false;
+  out->assign((const char*)text, (size_t)bytes);
+  return true;
+}
+
+// chronolog_policy_violation(table, command): always a
+// SQLITE_CONSTRAINT_FUNCTION error "chronolog_policy:<table>:<command>". The
+// consensus authorizer allows it only inside chronolog_* triggers and views.
+static void ChronologPolicyViolation(sqlite3_context* ctx, int, sqlite3_value** argv) {
+  std::string table, command;
+  if (!PolicyPart(argv[0], &table) || !PolicyPart(argv[1], &command)) {
+    sqlite3_result_error(ctx, "chronolog_policy_violation: arguments must be text of 1 to 128 bytes", -1);
+    return;
+  }
+  std::string message = "chronolog_policy:" + table + ":" + command;
+  sqlite3_result_error(ctx, message.c_str(), (int)message.size());
+  sqlite3_result_error_code(ctx, SQLITE_CONSTRAINT_FUNCTION);
+}
+
+static int ChronologRegisterFunctions(sqlite3* db, char**, const sqlite3_api_routines*) {
+  int rc = sqlite3_create_function_v2(db, "chronolog_assert", 2,
+    SQLITE_UTF8 | SQLITE_DETERMINISTIC | SQLITE_INNOCUOUS, nullptr, ChronologAssert, nullptr, nullptr, nullptr);
