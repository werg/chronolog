+/* Chronolog: 1 when the SQL contains the token sequence RAISE ( IGNORE, found
+** with SQLite's own tokenizer (whitespace and comments skipped), else 0. Used
+** to refuse application triggers that would skip rows silently. */
+int chronolog_sql_uses_raise_ignore(const char *zSql){
+  const unsigned char *z = (const unsigned char*)zSql;
+  int state = 0;
+  while( *z ){
+    int tokenType = 0;
+    i64 n = sqlite3GetToken(z, &tokenType);
+    if( n<=0 ) break;
+    z += n;
+    if( tokenType==TK_SPACE || tokenType==TK_COMMENT ) continue;
+    if( state==2 && tokenType==TK_IGNORE ) return 1;
+    if( state==1 && tokenType==TK_LP ){ state = 2; continue; }
+    state = tokenType==TK_RAISE ? 1 : 0;
+  }
+  return 0;
+}
