diff --git a/src/addon.cpp b/src/addon.cpp
index f99f1b18e14afd6dd1f1d690556eb7b4df5f048c..76dcfd4c6f763895e33c3df4bb0d564ce61982f2 100644
--- a/src/addon.cpp
