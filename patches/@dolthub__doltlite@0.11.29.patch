+    napi_value ignored;
+    napi_get_and_clear_last_exception(self->env_, &ignored);
+    return SQLITE_DENY;
+  }
+  if (!result.IsNumber()) return SQLITE_DENY;
+  return result.As<Napi::Number>().Int32Value();
