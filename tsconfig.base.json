{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@chronolog/canonical": [
        "packages/canonical/src/index.ts"
      ],
      "@chronolog/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@chronolog/crypto": [
        "packages/crypto/src/index.ts"
      ],
      "@chronolog/materializer": [
        "packages/materializer/src/index.ts"
      ],
      "@chronolog/materializer-doltlite": [
        "packages/materializer-doltlite/src/index.ts"
      ],
      "@chronolog/records": [
        "packages/records/src/index.ts"
      ],
      "@chronolog/materializer-doltlite/browser": [
        "packages/materializer-doltlite/src/browser.ts"
      ],
      "@chronolog/signals": [
        "packages/signals/src/index.ts"
      ],
      "@chronolog/transport-webrtc": [
        "packages/transport-webrtc/src/index.ts"
      ],
      "@chronolog/transport-webrtc/native": [
        "packages/transport-webrtc/src/native.ts"
      ],
      "@chronolog/peer-generation": [
        "packages/peer-generation/src/index.ts"
      ],
      "@chronolog/peer-generation/control": [
        "packages/peer-generation/src/control.ts"
      ],
      "@chronolog/peer-session": [
        "packages/peer-session/src/index.ts"
      ],
      "@chronolog/peer-session/native": [
        "packages/peer-session/src/native.ts"
      ],
      "@chronolog/peer-session/browser": [
        "packages/peer-session/src/browser.ts"
      ],
      "@chronolog/peer-session/webrtc": [
        "packages/peer-session/src/webrtc.ts"
      ],
      "@chronolog/peer-session/webrtc-native": [
        "packages/peer-session/src/webrtc-native.ts"
      ],
      "@chronolog/records/native": [
        "packages/records/src/native.ts"
      ],
      "@chronolog/records/browser": [
        "packages/records/src/browser.ts"
      ],
      "@chronolog/peer-session/sql-native": [
        "packages/peer-session/src/sql-native.ts"
      ],
      "@chronolog/peer-session/tendriller": [
        "packages/peer-session/src/tendriller.ts"
      ],
      "@chronolog/peer-session/sql": [
        "packages/peer-session/src/sql.ts"
      ],
      "@chronolog/peer-session/sql-browser": [
        "packages/peer-session/src/sql-browser.ts"
      ],
      "@chronolog/transport-websocket": [
        "packages/transport-websocket/src/index.ts"
      ],
      "@chronolog/peer-session/websocket": [
        "packages/peer-session/src/websocket.ts"
      ],
      "@chronolog/materializer/manifest": [
        "packages/materializer/src/manifest.ts"
      ],
      "@chronolog/peer-session/worker": [
        "packages/peer-session/src/worker.ts"
      ],
      "@chronolog/peer-generation/metadata": [
        "packages/peer-generation/src/metadata.ts"
      ]
    }
  }
}
